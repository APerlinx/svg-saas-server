# Server
NODE_ENV=development
PORT=4000

# Database (local Docker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/svg_saas

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Email (Resend)
RESEND_API_KEY=re_your-resend-api-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:4000/api/auth/github/callback

# Frontend
FRONTEND_URL=http://localhost:5173
FRONTEND_PREVIEW_REGEX=

# Redis
REDIS_URL=redis://localhost:6379
SVG_WORKER_CONCURRENCY=2

# Sentry (optional)
SENTRY_DSN=

# PayPal Billing (optional)
PAYPAL_ENABLED=false
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SUPPORTER_PLAN_ID=
# Optional overrides for checkout redirects
PAYPAL_RETURN_URL=http://localhost:5173/billing/paypal/success
PAYPAL_CANCEL_URL=http://localhost:5173/billing/paypal/cancel

# MCP Server
# Runs as a separate process on its own port (independent from the main API)
MCP_PORT=3001
#
# Testing the MCP server locally:
#
#   1. Start required services (Redis + DB):
#        docker compose up -d
#
#   2. Start the SVG generation worker (processes jobs):
#        npm run worker:dev
#
#   3. Start the MCP server:
#        npm run mcp:dev
#
#   4. Open the MCP Inspector:
#        npx @modelcontextprotocol/inspector
#
#   5. In the Inspector UI:
#        - Transport Type : Streamable HTTP
#        - URL            : http://localhost:3001/mcp
#        - Header         : Authorization = Bearer <oauth_access_token>
#
#   6. Get an OAuth access token for MCP:
#        - Metadata       : GET http://localhost:4000/.well-known/oauth-authorization-server
#        - Register       : POST http://localhost:4000/oauth/register
#        - Authorize      : GET/POST http://localhost:4000/oauth/authorize
#        - Token          : POST http://localhost:4000/oauth/token
#
#   7. Available tools:
#        - list_styles    : returns all valid style values
#        - generate_svg   : generates an SVG, returns jobId
#        - get_job_status : polls job status, returns SVG when done
#
# To connect via Claude Desktop, add to claude_desktop_config.json:
#   {
#     "mcpServers": {
#       "svg-saas": {
#         "type": "http",
#         "url": "http://localhost:3001/mcp",
#         "headers": { "Authorization": "Bearer <oauth_access_token>" }
#       }
#     }
#   }