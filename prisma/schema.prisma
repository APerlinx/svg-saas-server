datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String? // bcrypt hash
  name         String?
  provider     AuthProvider @default(EMAIL)
  providerId   String?
  plan         Plan         @default(FREE)
  credits      Int          @default(100) // Updated for new FREE plan (100 starting credits)
  avatar       String?

  notificationsLastSeenAt DateTime?

  // Credit Refill System (NEW - for 30-day rolling credit refills)
  creditRefillAmount Int?      // Amount of credits to refill (based on plan)
  lastCreditRefillAt DateTime? // Last time credits were refilled
  nextCreditRefillAt DateTime? // Next scheduled refill date

  // API Access (Legacy - kept for backward compatibility during migration)
  apiQuotaLimit   Int?      // Monthly API call limit (based on plan)
  apiQuotaUsed    Int?      @default(0) // Current month usage
  apiQuotaResetAt DateTime? // When quota resets (billing cycle)

  // Unified Generation Quota (New - replaces both daily limits and API quota)
  generationsQuotaLimit   Int?      // Monthly generation limit (based on plan, applies to both web + API)
  generationsQuotaUsed    Int?      @default(0) // Current month usage
  generationsQuotaResetAt DateTime? // When quota resets (30-day rolling window)

  generations     SvgGeneration[]
  refreshTokens   RefreshToken[]
  generationJobs  GenerationJob[]
  notifications   Notification[]
  apiKeys         ApiKey[]
  apiKeyUsageLogs ApiKeyUsageLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resetPasswordToken   String? // hashed token
  resetPasswordExpires DateTime?

  termsAcceptedAt DateTime?
  termsAcceptedIp String?

  @@unique([provider, providerId])
  @@index([email])
  @@index([plan])
}

model SvgGeneration {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String

  prompt      String
  svg         String // the actual SVG code
  style       String? // 'outline', 'duotone', etc.
  model       String? @default("gpt-4o")
  creditsUsed Int? // optional
  privacy     Boolean @default(false)

  s3Key String? @unique
  s3SizeBytes Int?

  createdAt DateTime @default(now())

  generationJob GenerationJob? @relation("JobToGeneration")

  @@index([userId, createdAt])
}

model RefreshToken {
  id String @id @default(cuid())

  // hashed token secret (never store plain token)
  token String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Group tokens that belong to the same login/session chain.
  // When you detect reuse, revoke the entire family.
  familyId String @default(cuid())

  // Rotation / revocation tracking
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime?

  revokedAt DateTime?

  replacedByTokenId String?       @unique
  replacedByToken   RefreshToken? @relation("TokenReplacement", fields: [replacedByTokenId], references: [id])
  replacesToken     RefreshToken? @relation("TokenReplacement")

  // Optional metadata
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([familyId])
  @@index([revokedAt])
}

model GenerationJob {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompt  String
  style   String?
  model   String  @default("gpt-4o")
  privacy Boolean @default(false)

  status GenerationJobStatus @default(QUEUED)

  createdAt     DateTime  @default(now())
  startedAt     DateTime?
  lastStartedAt DateTime?
  finishedAt    DateTime?

  errorCode       String?
  errorMessage    String?
  creditsCharged  Boolean @default(false)
  creditsRefunded Boolean @default(false)
  attemptsMade    Int     @default(0)
  lastFailedAt    DateTime?

  idempotencyKey String?
  requestHash    String?

  generationId String?        @unique
  generation   SvgGeneration? @relation("JobToGeneration", fields: [generationId], references: [id])

  aiModel            String?
  aiPromptTokens     Int?
  aiCompletionTokens Int?
  aiTotalTokens      Int?
  aiLatencyMs        Int?
  aiAttempts         Int?

  // API tracking
  source   GenerationSource @default(WEB_APP) // Track if from web app or API
  apiKeyId String? // If from API, which key was used
  apiKey   ApiKey?          @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([userId, status])
  @@index([apiKeyId])
  @@index([source, createdAt])
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title   String?
  message String

  data Json?

  jobId String?

  createdAt DateTime  @default(now())
  readAt    DateTime?
  expiresAt DateTime?

  @@unique([userId, jobId, type])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ApiKey {
  id          String  @id @default(cuid())
  name        String // User-friendly name (e.g., "Production Key", "CI/CD Pipeline")
  description String? // Optional description

  // Security: Never store raw key, only hash
  keyHash   String @unique // SHA-256 hash of the actual key
  keyPrefix String // First 8 chars for display (e.g., "sk_live_abc1...")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Lifecycle
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime? // Track last usage for security/cleanup
  expiresAt  DateTime? // Optional expiration date
  revokedAt  DateTime? // Soft delete - mark as revoked

  // Usage tracking
  usageCount Int @default(0) // Total number of requests

  // Permissions (future-proofing)
  scopes String[] @default(["generate:svg", "read:generation"]) // What this key can do

  // Rate limiting (optional per-key override)
  customRateLimit Int? // Custom rate limit for this specific key

  // Environment/Context
  environment String? @default("production") // "production", "development", "test"
  ipWhitelist String[] @default([]) // Optional IP restrictions

  // Relations
  generationJobs  GenerationJob[]
  apiKeyUsageLogs ApiKeyUsageLog[]

  @@index([userId])
  @@index([keyHash])
  @@index([userId, revokedAt])
  @@index([lastUsedAt])
}

model ApiKeyUsageLog {
  id String @id @default(cuid())

  apiKeyId String
  apiKey   ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Request details
  endpoint   String // e.g., "/v1/svg/generate"
  method     String // "POST", "GET", etc.
  statusCode Int // 200, 401, 429, etc.

  // Timing
  timestamp DateTime @default(now())
  latencyMs Int? // Request duration

  // Context
  ipAddress String?
  userAgent String?
  requestId String? // Correlation ID for debugging

  // Resource usage (for billing/analytics)
  creditsUsed Int? // How many credits were consumed
  tokensUsed  Int? // OpenAI tokens consumed

  @@index([apiKeyId, timestamp])
  @@index([userId, timestamp])
  @@index([timestamp])
  @@index([statusCode])
}

enum Plan {
  FREE
  SUPPORTER
}

enum AuthProvider {
  EMAIL // Traditional email/password
  GOOGLE // Google OAuth
  GITHUB // GitHub OAuth
}

enum GenerationJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum NotificationType {
  JOB_SUCCEEDED
  JOB_FAILED
  LOW_CREDITS
  PROMO_MONTHLY
  CREDITS_PURCHASED
  CREDITS_REFUNDED
  ACCOUNT_SECURITY
  SYSTEM_ANNOUNCEMENT
}

enum GenerationSource {
  WEB_APP // Generated via web interface
  API // Generated via API key
}
